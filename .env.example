# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=

# Allowed Telegram User ID (from @userinfobot)
TELEGRAM_ALLOWED_USER_ID=

# Telegram Proxy URL (optional)
# Supports socks5://, socks4://, http://, https:// protocols
# Examples:
#   TELEGRAM_PROXY_URL=socks5://proxy.example.com:1080
#   TELEGRAM_PROXY_URL=socks5://user:password@proxy.example.com:1080
#   TELEGRAM_PROXY_URL=http://proxy.example.com:8080
# TELEGRAM_PROXY_URL=

# OpenCode API URL (optional)
# Defaults depend on OPENCODE_SERVER_VERSION: v1 -> http://localhost:4096, v2 -> http://127.0.0.1:49374
# OPENCODE_API_URL=http://localhost:4096

# OpenCode server API version (optional, default: v1)
# v1 = classic OpenCode server, v2 = OpenCode v2 (opencode v2.x, e.g. serve port 49374)
# The bot speaks exactly the configured version; a mismatch is reported at startup.
# OPENCODE_SERVER_VERSION=v2

# OpenCode Server Authentication (optional)
# OPENCODE_SERVER_USERNAME=opencode
# OPENCODE_SERVER_PASSWORD=

# OpenCode Model Configuration (REQUIRED)
# You must specify a default model provider and model ID
# Examples:
#   Anthropic Claude 3.5 Sonnet: OPENCODE_MODEL_PROVIDER=anthropic, OPENCODE_MODEL_ID=claude-3-5-sonnet-20241022
#   OpenAI GPT-4 Turbo: OPENCODE_MODEL_PROVIDER=openai, OPENCODE_MODEL_ID=gpt-4-turbo
#   Groq Mixtral: OPENCODE_MODEL_PROVIDER=groq, OPENCODE_MODEL_ID=mixtral-8x7b-32768
OPENCODE_MODEL_PROVIDER=opencode
OPENCODE_MODEL_ID=big-pickle

# Server Configuration (optional)
# Logging level: debug, info, warn, error (default: info)
# Use "debug" to see detailed diagnostic logs including all bot events
# LOG_LEVEL=info

# Port of the internal health endpoint (default: off; 3100 inside the Docker image; 0 disables)
# Serves GET /health, /health/live and /health/ready on 127.0.0.1 only.
# The Docker image's HEALTHCHECK probes /health/live on this port.
# BOT_HEALTH_PORT=3100

# Bot Configuration (optional)
# Maximum number of sessions shown in /sessions (default: 10)
# SESSIONS_LIST_LIMIT=10

# Maximum number of projects shown in /projects (default: 10)
# PROJECTS_LIST_LIMIT=10

# Maximum number of commands shown per page in /commands (default: 10)
# COMMANDS_LIST_LIMIT=10

# Allowed root directories for /open, comma-separated absolute paths.
# Defaults to your home directory when unset.
# OPEN_BROWSER_ROOTS=~/projects,/srv/repos

# Bot locale: supported locale code (default: en)
# Supported locales: en, de, es, fr, id, ru, tr, zh
# BOT_LOCALE=en

# Service message batching interval in seconds (thinking + tool calls, default: 5)
# Recommended: keep >=2 to reduce risk of hitting Telegram rate limits (about 1 message/sec)
# 0 = send immediately (can hit rate limits if there are many tool calls)
# SERVICE_MESSAGES_INTERVAL_SEC=5

# Hide thinking indicator messages (default: false)
# HIDE_THINKING_MESSAGES=false

# Hide tool call service messages (default: false)
# HIDE_TOOL_CALL_MESSAGES=false

# Hide tool file messages sent as documents (default: false)
# HIDE_TOOL_FILE_MESSAGES=false

# Show code diffs as text code blocks instead of .txt documents (default: true)
# CODE_BLOCKS_IN_TEXT=true

# Track background sessions started from PC and notify in Telegram (default: true)
# TRACK_BACKGROUND_SESSIONS=true

# Show background session notices (assistant replies, questions, permissions) (default: true)
# Can also be flipped at runtime with /display
# SHOW_BACKGROUND_NOTIFICATIONS=true

# Mirror prompts typed on PC into the session topic as 🧑 messages (default: true)
# Can also be flipped at runtime with /display
# SHOW_PC_USER_MIRROR=true

# Show link previews under assistant messages (default: true)
# Bot control messages never show previews
# Can also be flipped at runtime with /display
# SHOW_LINK_PREVIEWS=true

# All display flags above (except TRACK_BACKGROUND_SESSIONS) can be flipped
# at runtime from Telegram with /display; overrides persist in settings.json

# Assistant message formatting mode (default: markdown)
# markdown = convert assistant replies to Telegram MarkdownV2
# raw = show assistant replies as plain text
# MESSAGE_FORMAT_MODE=markdown

# Assistant stream update throttle in milliseconds (default: 1000)
# Increase this if Telegram hits rate limits during heavy streaming.
# RESPONSE_STREAM_THROTTLE_MS=1000

# Maximum displayed length for bash tool commands and execute tool code (OpenCode V2 Code Mode)
# in Telegram summaries (default: 128)
# Longer commands and code are truncated with "..."
# BASH_TOOL_DISPLAY_MAX_LENGTH=128

# Start a managed OpenCode server at bot startup when none is reachable (default: true)
# With false, start it manually from PC or with /opencode_start
# OPENCODE_AUTO_START=true

# Maximum execution time for a scheduled task in minutes (default: 120)
# If exceeded, the bot stops waiting for the result and marks the run as failed.
# SCHEDULED_TASK_EXECUTION_TIMEOUT_MINUTES=120

# Daily spend alert in USD (default: 0 = off)
# When today's total reaches this amount, the bot sends one warning per day.
# BUDGET_ALERT_USD=0

# Background offer delay in seconds before proposing ⏪ for a running shell/subagent tool (default: 3, like the TUI hint)
# BACKGROUND_OFFER_AFTER_SEC=3

# Code File Settings (optional)
# Maximum file size in KB to send as document (default: 100)
# CODE_FILE_MAX_SIZE_KB=100

# Speech-to-Text / Voice Recognition (optional)
# Enable voice message transcription by setting a Whisper-compatible API URL.
# Works with OpenAI, Groq, or any Whisper-compatible endpoint.
# If STT_API_URL is not set, voice messages will get a "not configured" reply.
# STT_API_URL=
# STT_API_KEY=
# Protocol: "openai" (default, POST {URL}/audio/transcriptions with key) or
# "plain" for minimal custom workers (POST the URL as-is with an `audio` wav
# field, no auth; non-wav input is converted with ffmpeg, key not required).
# STT_PROTOCOL=openai
# STT_AUDIO_FIELD= (overrides the multipart field: "file" for openai, "audio" for plain)
# STT_TIMEOUT_SEC=60
# STT_FFMPEG_PATH= (absolute path to ffmpeg; needed when it is not on the service PATH)
# STT_MODEL=
# STT_LANGUAGE=
# STT_NOTE_PROMPT="The following text is transcribed from voice. It may contain homophone or phonetic errors. Infer the intended meaning from context."

# Text-to-Speech credentials (optional)
# TTS reply behavior is controlled globally with /tts and persisted in settings.json.
# Set both TTS_API_URL and TTS_API_KEY to enable audio replies.
# TTS_API_URL=
# TTS_API_KEY=
# TTS_MODEL=gpt-4o-mini-tts
# TTS_VOICE=alloy
